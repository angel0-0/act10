<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Act10" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/moradillo</item>
        <item name="colorOnPrimaryContainer">@color/purple</item>
        <item name="colorSecondary">@color/laiblue</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Edge-to-Edge -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Background color -->
        <item name="android:windowBackground">@color/purple</item>
    </style>

    <style name="Theme.Act10" parent="Base.Theme.Act10" />
</resources>